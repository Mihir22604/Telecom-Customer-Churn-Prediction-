# ==============================================================================
# Telecom Customer Churn Prediction & Retention System - Environment Config
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=production

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501

# Inter-service Communication
FASTAPI_URL=http://localhost:8000

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Model Artifacts & Versioning
MODEL_VERSION=1.0.0
MODEL_PATH=models/best_churn_model.joblib
MODEL_METADATA_PATH=models/model_metadata.json

# Security & CORS
CORS_ORIGINS=*
SECRET_KEY=telecom-churn-retention-secret-key-change-in-prod
